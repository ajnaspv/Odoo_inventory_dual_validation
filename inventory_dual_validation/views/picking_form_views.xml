<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <data>
       <record id="view_picking_form_inherit_duel_validation" model="ir.ui.view">
           <field name="name">stock.view_picking_form.inherit.duel.validation</field>
           <field name="model">stock.picking</field>
           <field name="inherit_id" ref="stock.view_picking_form"/>
           <field name="arch" type="xml">
               <!-- Use xpath to locate where to add the new field -->
               <xpath expr="//button[@name='button_validate'][2]" position="after">
<!--                   <button name="action_request_approval" type="object" string="Request For Approval"-->
<!--                            class="btn-warning" invisible="state != 'assigned' or picking_type_code != 'internal'"-->
<!--                            groups="inventory_dual_validation.internal_transfer_staff_user"-->
<!--                   />-->
                   <button name="button_approve" type="object" string="Approve"
                            class="btn-primary"
                            groups="inventory_dual_validation.internal_transfer_approver"
                            invisible="state != 'to_approve' or picking_type_code != 'internal'"
                   />
                   <button name="action_cancel" type="object" string="Reject"
                            class="btn-warning"
                            groups="inventory_dual_validation.internal_transfer_approver"
                            invisible="state != 'to_approve' or picking_type_code != 'internal'"
                   />
               </xpath>
               <xpath expr="//button[@name='button_validate'][2]" position="attributes">
                   <attribute name="invisible" add="state == 'to_approve'" separator="or"/>
               </xpath>
           </field>
       </record>
   </data>
</odoo>
